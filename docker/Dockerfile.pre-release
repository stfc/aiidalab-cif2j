FROM aiidalab/full-stack:latest

LABEL maintainer="Dr Benjamin T. Speake <benjamin.speake@stfc.ac.uk>"
LABEL org.opencontainers.image.source="https://github.com/stfc/aiidalab-cif2j"

USER root

# Pin the app source to a specific commit/branch/tag, baked into the image,
# rather than letting AIIDALAB_DEFAULT_APPS pull whatever is currently
# published to the registry at container startup.
ARG CIF2J_APP_REPO=https://github.com/stfc/aiidalab-cif2j.git
ARG CIF2J_APP_REF=main
ENV CIF2J_APP_DIR=/opt/aiidalab-cif2j

ENV CIF2J_QE_VERSION=7.4
ENV CIF2J_WANNIER90_VERSION=3.1.0
ENV CIF2J_TB2J_VERSION=0.9.22
ENV CIF2J_ENV=${HOME}/.conda/envs/cif2j-${CIF2J_QE_VERSION}

USER ${NB_USER}
WORKDIR ${HOME}

# Install Quantum ESPRESSO and Wannier90 into a shared conda environment.
RUN mamba create --yes --override-channels --channel conda-forge \
        --prefix "${CIF2J_ENV}" \
        "qe=${CIF2J_QE_VERSION}" "wannier90=${CIF2J_WANNIER90_VERSION}" \
        "python<3.13" pip && \
    mamba clean --all -f -y && \
    "${CIF2J_ENV}/bin/pip" install --no-cache-dir "TB2J==${CIF2J_TB2J_VERSION}"

USER root

# Clone the app source into /opt, the same way the base image bakes in the
# home app at /opt/aiidalab-home, so it is installed via `aiidalab install
# file://` once the main AiiDAlab setup has run (see 61_install_cif2j_app.sh)
# rather than via AIIDALAB_DEFAULT_APPS.
RUN git clone --branch "${CIF2J_APP_REF}" --depth 1 \
        "${CIF2J_APP_REPO}" "${CIF2J_APP_DIR}" && \
    rm -rf "${CIF2J_APP_DIR}/.git" && \
    fix-permissions "${CIF2J_APP_DIR}"

# Generate one AiiDA code config per codes/code.yml.template entry (see
# generate_codes.sh), then register them with AiiDA at container startup
# once the profile exists.
COPY codes/code.yml.template generate_code_configs.sh /opt/cif2j/
RUN bash /opt/cif2j/generate_code_configs.sh

COPY 61_install_cif2j_app.sh 62_setup_cif2j_codes.sh /usr/local/bin/before-notebook.d/

USER ${NB_USER}
WORKDIR ${HOME}
